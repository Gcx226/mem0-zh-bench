# ===== 被测系统：自托管 mem0 REST API =====
# 部署 mem0 server 后填写（默认本地 8888）。MEM0_API_KEY 在 mem0 dashboard 创建。
MEM0_API_URL=http://localhost:8888
MEM0_API_KEY=

# ===== 作答 + 数据生成 LLM（OpenAI 兼容接口）=====
# 默认 DeepSeek。LLM_API_KEY 填你配置 mem0 时用的那把 LLM key。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ===== 裁判 LLM（LLM-as-Judge，OpenAI 兼容接口）=====
# 默认 SiliconFlow Qwen2.5-72B。需单独填 JUDGE_API_KEY。
JUDGE_BASE_URL=https://api.siliconflow.cn/v1
JUDGE_MODEL=Qwen/Qwen2.5-72B-Instruct
JUDGE_API_KEY=

# SiliconFlow 作答示例（与 DeepSeek 二选一，取消注释并填 key）:
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# LLM_API_KEY=